# Copy to .env and fill in. Never commit .env.
# The scripts load .env themselves.

# --- Hosted language model (needed for the live evaluation) ---
# Only an OpenAI-compatible chat endpoint is supported.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Public test network (needed for deployment and on-chain evidence) ---
# Allowed chain ids: 84532 (Base Sepolia), 11155111 (Sepolia). Never a main network.
TESTNET_CHAIN_ID=84532
TESTNET_RPC_URL=
# A brand-new key that has never held anything of value, funded from a faucet.
# Helper keys for the agent, guardian and peer wallets are derived or generated by the scripts.
OWNER_PRIVATE_KEY=
# Optional: block explorer base URL for links in docs/EVIDENCE.md
EXPLORER_URL=https://sepolia.basescan.org
